# =============================================================================
# Addon Generator API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# At minimum, you need ONE LLM provider configured.
# For best results with anime/novel/movie universes, add OPENROUTER_API_KEY.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Addon Generator API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/addon_generator
# Neon (free): postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# Supabase (free): postgresql+asyncpg://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/addon_generator
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Redis (Queue, Cache, Rate Limiting)
# -----------------------------------------------------------------------------
# Local Docker: redis://localhost:6379/0
# Upstash (free): rediss://default:token@xxx.upstash.io:6379
# Railway (free): redis://default:pass@xxx.railway.internal:6379
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# LLM PROVIDERS - API KEYS
# =============================================================================
# RECOMMENDED: OpenRouter (one key for GPT-4o, Claude, DeepSeek, Gemini, Llama, etc.)
# Get free key at: https://openrouter.ai/keys
# Free models available: deepseek/deepseek-chat:free, meta-llama/llama-3.1-8b-instruct:free, etc.
# Paid models: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-1.5-pro
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_FREE_MODEL=deepseek/deepseek-chat:free

# -----------------------------------------------------------------------------
# Groq (FREE - very fast, generous limits)
# Get key at: https://console.groq.com/keys
# Models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# -----------------------------------------------------------------------------
# Together AI (FREE tier - good for Llama 405B, FLUX image gen)
# Get key at: https://api.together.xyz/settings/api-keys
# Models: meta-llama/Llama-3.1-405B-Instruct-Turbo, black-forest-labs/FLUX.1-schnell-Free
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_DEFAULT_MODEL=meta-llama/Llama-3.1-405B-Instruct-Turbo
TOGETHER_FLUX_MODEL=black-forest-labs/FLUX.1-schnell-Free

# -----------------------------------------------------------------------------
# Google AI Studio (FREE - Gemini 1.5 Flash/Pro, 1M context)
# Get key at: https://aistudio.google.com/apikey
# Models: gemini-1.5-flash, gemini-1.5-pro
GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-1.5-flash
GOOGLE_PRO_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# OPTIONAL: Direct Provider Keys (if you have them)
# -----------------------------------------------------------------------------
# OpenAI Direct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic Direct
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# DeepSeek Direct (very cheap)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Local Ollama (no key needed, runs locally)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull: ollama pull llama3.3:70b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.3:70b

# -----------------------------------------------------------------------------
# LLM Router Configuration
# -----------------------------------------------------------------------------
ROUTER_DEFAULT_PROVIDER=groq
ENABLE_OPENROUTER=true
ENABLE_GROQ=true
ENABLE_TOGETHER=true
ENABLE_GOOGLE=true
ENABLE_OPENAI=false
ENABLE_ANTHROPIC=false
ENABLE_DEEPSEEK=false
ENABLE_OLLAMA=false

# Rate limits (requests per minute)
RATE_LIMIT_GROQ=30
RATE_LIMIT_TOGETHER=60
RATE_LIMIT_OPENROUTER=20
RATE_LIMIT_GOOGLE=15
RATE_LIMIT_OPENAI=10
RATE_LIMIT_ANTHROPIC=10
RATE_LIMIT_DEEPSEEK=30
RATE_LIMIT_OLLAMA=100

# -----------------------------------------------------------------------------
# Image Generation (Together AI FLUX is FREE and excellent)
# -----------------------------------------------------------------------------
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
TOGETHER_IMAGE_STEPS=4
TOGETHER_IMAGE_WIDTH=1024
TOGETHER_IMAGE_HEIGHT=1024

# Replicate (optional, for more models)
REPLICATE_API_TOKEN=

# Hugging Face (optional)
HF_API_TOKEN=

# -----------------------------------------------------------------------------
# 3D Generation (optional - for model generation)
# -----------------------------------------------------------------------------
# Hunyuan3D (Tencent) - free tier
HUNYUAN3D_API_URL=https://api.hunyuan3d.com/v1
HUNYUAN3D_API_KEY=

# Tripo3D - free tier
TRIPO3D_API_URL=https://api.tripo3d.ai/v1
TRIPO3D_API_KEY=

# Meshy - free tier (200 credits/month)
MESHY_API_URL=https://api.meshy.ai/v1
MESHY_API_KEY=

# -----------------------------------------------------------------------------
# Audio Generation (optional)
# -----------------------------------------------------------------------------
# ElevenLabs - 10k chars/month free
ELEVENLABS_API_KEY=

# Bark (Suno) - open source, can run local
BARK_API_URL=https://api.bark.suno.ai/v1

# -----------------------------------------------------------------------------
# Minecraft Configuration
# -----------------------------------------------------------------------------
MINECRAFT_MIN_VERSION=26.40
SUPPORTED_EDITIONS=bedrock,java,both
DEFAULT_EDITION=bedrock

# Bedrock JSON Schemas for validation
BEDROCK_SCHEMAS_URL=https://raw.githubusercontent.com/bedrock-studio/bedrock-json-schemas/main/schemas

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
OUTPUT_DIR=./output
TEMP_DIR=./temp
MAX_FILE_SIZE_MB=100

# -----------------------------------------------------------------------------
# CORS (Frontend URLs)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-vercel-app.vercel.app

# -----------------------------------------------------------------------------
# Task Queue
# -----------------------------------------------------------------------------
TASK_QUEUE_NAME=addon_tasks
TASK_RESULT_TTL=86400
TASK_TIMEOUT=1800
